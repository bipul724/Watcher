# =========================================================================
# WatcherAgent - Environment Configuration Example (Deployment Template)
# Copy this file to `.env` and fill in the required values.
# =========================================================================

# -------------------------------------------------------------------------
# 1. Required System & Infrastructure Variables
# -------------------------------------------------------------------------
# Port on which the Watcher API server listens
PORT=3001

# The backend API server URL (NOT the frontend client URL).
# This is used by the background queue workers and Discord Bot to communicate 
# with the API server (e.g. updating job statuses and sending approval callbacks).
ORCHESTRATOR_URL=http://localhost:3001

# Comma-separated list of allowed CORS origins in production (e.g. https://watcher.domain.com).
# Leave blank or omit to allow all origins (*) during local development.
ALLOWED_ORIGINS=

# Pre-shared security token (can be a randomly generated 32-character hex string).
# This secures communication between the worker processes, Discord Bot, and the API server.
# When a user clicks a button in Discord (e.g. to approve a fix), this secret is sent in the 
# headers to verify the request is authentic and prevent unauthorized webhook spoofing.
INTERNAL_CALLBACK_SECRET=your_secure_internal_callback_secret_here

# Encryption key used to secure user-supplied keys and tokens in the PostgreSQL database (AES-256-GCM).
# Provide a secure 32-character string or custom passphrase. 
# Defaults to JWT_SECRET if left blank.
ENCRYPTION_KEY=your_postgres_secrets_encryption_key_here

# -------------------------------------------------------------------------
# 2. Required Global Services (System-Wide Integrations)
# -------------------------------------------------------------------------
# Global Pinecone Vector Database used by the system for Codebase RAG / Knowledge Base.
# (Individual projects do not supply Pinecone keys; the system uses this singular global DB).
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=guardian-knowledge

# Global Discord Bot Configuration.
# Used by the system to post alerts, prompt human-in-the-loop validation, and receive action approvals.
DISCORD_BOT_TOKEN=your_global_discord_bot_token_here

OPENROUTER_API_KEY=
DEFAULT_LLM_MODEL=google/gemini-2.5-flash
# -------------------------------------------------------------------------
# 3. Optional Global Fallbacks (If not provided by the Customer in the UI)
# -------------------------------------------------------------------------

# Default LLM provider keys used as system fallbacks if the project settings do not define them.
# The customer can override these keys by entering their own in their project dashboard.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Default GitHub credentials used as a system fallback if a project does not supply its own
# GitHub integration token/repository information in the dashboard.
GITHUB_TOKEN=
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=
