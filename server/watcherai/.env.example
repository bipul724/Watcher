# Watcher - Environment Configuration Example

# Server Config
PORT=3000
# INTERNAL_CALLBACK_SECRET is used for Discord callbacks
INTERNAL_CALLBACK_SECRET=generate_with_node_e_console_log_require_crypto_randomBytes_32_toString_hex
# Pipeline execution timeout
PIPELINE_TIMEOUT_MS=90000

# OpenRouter (LLM Orchestration)
# Get your key at https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key
# Recommended models: 'google/gemini-flash-1.5' or 'meta-llama/llama-3-8b'
DEFAULT_LLM_MODEL=google/gemini-flash-1.5
LLM_TIMEOUT_MS=30000

# Pinecone (Vector RAG)
# Get your key at https://www.pinecone.io/
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX_NAME=guardian-knowledge

# Discord (HITL Interface)
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_INCIDENT_CHANNEL_ID=your_channel_id
# Human-in-the-loop timeout
HITL_TIMEOUT_MS=900000
# URL where the orchestrator is running (accessible by the Discord bot/callback)
ORCHESTRATOR_URL=http://localhost:3000

# GitHub (Fix Deployment)
GITHUB_TOKEN=your_personal_access_token
GITHUB_REPO_OWNER=your_github_username
GITHUB_REPO_NAME=your_repo_name
